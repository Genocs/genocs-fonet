<?xml version="1.0" encoding="UTF-8"?>
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format">
    <fo:layout-master-set>
        <fo:simple-page-master master-name="A4" page-width="210mm" page-height="297mm" margin="20mm">
            <fo:region-body/>
        </fo:simple-page-master>
    </fo:layout-master-set>
    <fo:page-sequence master-reference="A4">
        <fo:flow flow-name="xsl-region-body">
            <fo:block font-family="Nunito" font-size="12pt">
                Overlapping absolutely positioned block containers below use z-index for stacking.
            </fo:block>

            <fo:block-container absolute-position="absolute" top="40mm" left="10mm"
                                width="6cm" height="2.5cm" z-index="1000"
                                background-color="#FFCCCC" padding="4pt">
                <fo:block font-family="Nunito" font-size="10pt">Back layer (z-index 1000)</fo:block>
            </fo:block-container>

            <fo:block-container absolute-position="absolute" top="50mm" left="20mm"
                                width="6cm" height="2.5cm" z-index="2000"
                                background-color="#CCCCFF" padding="4pt">
                <fo:block font-family="Nunito" font-size="10pt">Front layer (z-index 2000)</fo:block>
            </fo:block-container>
        </fo:flow>
    </fo:page-sequence>
</fo:root>
