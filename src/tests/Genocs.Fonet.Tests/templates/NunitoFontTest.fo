<?xml version="1.0" encoding="UTF-8"?>
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format">
	<fo:layout-master-set>
		<fo:simple-page-master master-name="A4" page-width="210mm" page-height="297mm" margin="20mm">
			<fo:region-body/>
		</fo:simple-page-master>
	</fo:layout-master-set>
	<fo:page-sequence master-reference="A4">
		<fo:flow flow-name="xsl-region-body">
			<fo:block font-family="Nunito" font-size="12pt" color="black">
				Nunito 12pt Black
			</fo:block>
			<fo:block font-family="Nunito" font-size="16pt" color="blue">
				Nunito 16pt Blue
			</fo:block>
			<fo:block font-family="Nunito" font-size="20pt" color="red">
				Nunito 20pt Red
			</fo:block>
			<fo:block font-family="Nunito" font-size="24pt" color="#00AA00">
				Nunito 24pt Green
			</fo:block>
			<fo:block font-family="Nunito" font-size="28pt" color="#FF9900">
				28pt Orange Nunito
			</fo:block>
			<fo:block font-family="Nunito" font-size="28pt" color="#FF9900">
				28pt Orange Sans-Serif
			</fo:block>
			<fo:block font-family="Nunito" font-size="28pt" color="#FF9900">
				28pt Orange Monospace
			</fo:block>
			<fo:block font-family="Nunito" font-size="28pt" color="#FF9900">
				28pt Orange Arial
			</fo:block>
		</fo:flow>
	</fo:page-sequence>
</fo:root>
