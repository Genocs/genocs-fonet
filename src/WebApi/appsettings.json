{
  "app": {
    "name": "Genocs.Fonet.WebApi",
    "service": "pdf-printer",
    "instance": "local",
    "version": "1.0.0"
  },
  "logger": {
    "level": "Information",
    "console": {
      "enabled": true
    },
    "file": {
      "enabled": false
    },
    "excludePaths": [ "/health", "/swagger" ]
  },
  "mongoDb": {
    "connectionString": "mongodb://localhost:27017",
    "database": "fonet_pdf",
    "seed": true,
    "enableTracing": false
  },
  "pdfStorage": {
    "templatesPath": "data/templates",
    "fontsPath": "data/fonts",
    "assetsPath": "data/assets"
  },
  "openapi": {
    "enabled": false,
    "reDocEnabled": false,
    "name": "fonet",
    "title": "Genocs Fonet PDF API",
    "version": "v1",
    "description": "Minimal API that builds PDFs from XSLT templates using Genocs.Fonet.",
    "routePrefix": "swagger",
    "includeSecurity": false,
    "contactName": "Giovanni Nocco",
    "contactEmail": "giovanni.nocco@genocs.com",
    "contactUrl": "https://www.genocs.com",
    "licenseName": "MIT",
    "licenseUrl": "https://www.genocs.com/license.html",
    "termsOfService": "https://www.genocs.com/terms_and_conditions.html",
    "servers": [
      {
        "url": "http://localhost:5080",
        "description": "Local version to be used for development"
      }
    ]
  },
  "webApi": {
    "bindRequestFromRoute": true
  },
  "AllowedHosts": "*"
}
