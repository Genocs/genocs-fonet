<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>Genocs.Fonet.WebApi</AssemblyName>
        <RootNamespace>Genocs.Fonet.WebApi</RootNamespace>
        <UserSecretsId>Genocs</UserSecretsId>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <DockerfileContext>..\..</DockerfileContext>
        <IsPackable>false</IsPackable>
        <!-- Disable web.config transformation for Docker builds -->
        <TransformWebConfigEnabled>false</TransformWebConfigEnabled>
        <WebConfigTransformEnabled>false</WebConfigTransformEnabled>
        <!-- Avoid CS1591 noise until public APIs are fully documented -->
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Genocs.Core" Version="9.0.1" />
        <PackageReference Include="Genocs.Logging" Version="9.0.1" />
        <PackageReference Include="Genocs.Persistence.MongoDB" Version="9.0.1" />
        <PackageReference Include="Genocs.WebApi" Version="9.0.1" />
        <PackageReference Include="Genocs.WebApi.OpenApi" Version="9.0.1" />

        <PackageReference Include="FluentResults" Version="4.0.0" />
        <PackageReference Include="MediatR" Version="14.2.0" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
        <!-- Ensure libSkiaSharp.so is copied into Docker publish output (native assets are not always transitive) -->
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.150.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Genocs.Fonet.XsltTransformer\Genocs.Fonet.XsltTransformer.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Update="data\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
      <None Update="data\assets\icon.jpg">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="data\assets\icon.png">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="data\fonts\Nunito-Bold.ttf">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="data\fonts\Nunito-Italic.ttf">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="data\fonts\Nunito-Regular.ttf">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="data\templates\book-row-template.fo">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="data\templates\books.fo">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="data\templates\browserstack-logo.svg">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="data\templates\footer.fo">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="data\templates\header.fo">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="data\templates\NunitoSample.fo">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="data\templates\test.svg">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
