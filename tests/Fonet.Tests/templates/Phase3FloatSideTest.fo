<?xml version="1.0" encoding="UTF-8"?>
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format">
  <fo:layout-master-set>
    <fo:simple-page-master master-name="A4" page-width="210mm" page-height="297mm" margin="20mm">
      <fo:region-body/>
    </fo:simple-page-master>
  </fo:layout-master-set>
  <fo:page-sequence master-reference="A4">
    <fo:flow flow-name="xsl-region-body">
      <fo:block font-family="Nunito" font-size="12pt">
        Introduction text before the side float.
      </fo:block>

      <fo:float float="left">
        <fo:block font-family="Nunito" font-size="10pt" background-color="#CCCCFF" padding="4pt" width="4cm">
          Floated sidebar content on the left.
        </fo:block>
      </fo:float>

      <fo:block font-family="Nunito" font-size="12pt">
        This text follows the float and should wrap beside it on the right.
        Adding more words so the block spans multiple lines and exercises side-float layout.
        The floated box should remain on the left while this paragraph flows around it.
      </fo:block>

      <fo:float float="right">
        <fo:block font-family="Nunito" font-size="10pt" background-color="#FFCCCC" padding="4pt" width="3.5cm">
          Right-side float content.
        </fo:block>
      </fo:float>

      <fo:block font-family="Nunito" font-size="12pt">
        Another paragraph that should wrap around the right-side float on its left.
        More filler text to ensure several lines are generated for layout testing purposes.
      </fo:block>

      <fo:block font-family="Nunito" font-size="12pt" clear="both" background-color="#EEFFEE" padding="4pt">
        This block clears both floats and should appear below them at full column width.
      </fo:block>
    </fo:flow>
  </fo:page-sequence>
</fo:root>
